# Copy to .env and edit yourself. No token or model key belongs in this file.
AI_OPS_IMAGE=ghcr.io/hewenze11/ai-ops:latest
AI_OPS_BIND=127.0.0.1
AI_OPS_PORT=8765
# 0 keeps the control CONTAINER out of the user-facing managed-asset list.
AI_OPS_LOCAL_CONNECTOR_ENABLED=0
# Turn these on intentionally after configuring notifications / role memory.
AI_OPS_ALERT_NOTIFY_ENABLED=0
AI_OPS_MEMORY_ARCHIVER_ENABLED=0
